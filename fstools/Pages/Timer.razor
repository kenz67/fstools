@page "/timer"

@using MudBlazor
@using fstools.Models
@using fstools.Services

@inject NavigationManager NavManager
@inject TimerService Timers

<PageTitle>Timers</PageTitle>

<h1>Timers</h1>

<MudStack Spacing="1" Direction="Row" AlignItems="AlignItems.Center">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddTimer">Add Timer</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="ResetTimers">Reset</MudButton>
</MudStack>

<br />

@for (int i = 1; i <= timerCount; i++)
{
    var showButtons = i > 1;
    <StopwatchComponent timerText="@getText(@i)" timerNumber=@i timersIn="@Timers.Timers" infoIn="@Timers.Info"
                        showButtons="@showButtons" />
    <MudDivider />
}

@code
{
    [CascadingParameter]
    public MainLayout MainLayout { get; set; }

    int timerCount;

    protected override void OnInitialized()
    {
        timerCount = Timers.TimerCnt;
        if (timerCount.Equals(0))
        {
            Timers.Timers.Add(new FsTimer());
            Timers.Info.Add(new StopwatchInfo());
            Timers.TimerCnt = 1;
        }

        timerCount = Math.Max(1, Timers.TimerCnt);
    }

    public string getText(int i) => $"Timer {i}";

    public void AddTimer()
    {
        // add directly to the service so the state persists
        Timers.Timers.Add(new FsTimer());
        Timers.Info.Add(new StopwatchInfo());
        timerCount++;
        Timers.TimerCnt = timerCount;
        StateHasChanged();
    }

    void ResetTimers()
    {
        timerCount = 1;
        NavManager.NavigateTo("/timer", true);
    }
}
@page "/notes"
@using MudBlazor
@using Tizzani.MudBlazor.HtmlEditor
@using fstools.Services
@inject NotesService NotesData

<PageTitle>Notes</PageTitle>

<h1 style="display:flex; align-items:center; gap:1rem;">
    <span>Notes</span>
    <div style="margin-left: auto;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SetDefault">Default</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Clear">Clear</MudButton>
    </div>
</h1>

<MudHtmlEditor @ref="editor" HtmlChanged="OnEditorChanged" Height="750" ToolbarItems="@ToolbarItems" />

@code
{
    private MudHtmlEditor editor;
    private readonly int DebounceDelay = 750; // ms
    private CancellationTokenSource _debounceCts;

    private List<object> ToolbarItems = new List<object>
    {
        new List<object>
        {
            "style", new List<string>()
            {
                "style"
            }
        },
        new List<object>
        {
            "fontstyle", new List<string>()
            {
                "bold", "italic", "underline", "clear"
            }
        },
        new List<object>
        {
            "font", new List<string>()
            {
                "strikethrough", "superscript", "subscript"
            }
        },
        new List<object>
        {
            "fontsize", new List<string>()
            {
                "fontsize"
            }
        },
        new List<object>
        {
            "color", new List<string>()
            {
                "color"
            }
        },
        new List<object>
        {
            "para", new List<string>()
            {
                "ul", "ol", "paragraph"
            }
        },
        new List<object>
        {
            "misc", new List<string>()
            {
                "undo", "redo"
            }
        },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await editor.SetHtml(NotesData.Notes);
        }
    }

    public void Clear()
    {
        NotesData.Notes = string.Empty;
        editor.SetHtml(NotesData.Notes);
    }

    public void SetDefault()
    {       
        NotesData.SetDefault();
        editor.SetHtml(NotesData.Notes);
    }

    private async Task OnEditorChanged(string html)
    {
        // Cancel any pending save
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            // Wait for the debounce window
            await Task.Delay(DebounceDelay, token);

            // If not canceled, perform the save
            NotesData.Notes = await editor.GetHtml();
        }
        catch (TaskCanceledException)
        {
            // Expected when user keeps typing
        }
    }
}

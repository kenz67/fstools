@page "/charts"

@using System.Linq;
@using Newtonsoft.Json;
@using fstools.Models;
@using fstools.Services;
@using MudBlazor;
@using Microsoft.AspNetCore.Components.Web;

@inject ChartService ChartSvc;
@inject BrowserService BrowserSvc;
@inject IJSRuntime jsRuntime;
@inject WeatherService WeatherSvc;
@inject IcaoService icaoService;

<PageTitle>Charts</PageTitle>

<h1>Charts</h1>

<MudExpansionPanels>
    <MudExpansionPanel Text="Search" Expanded="@(!ChartSvc.ShowPdf)">
         <div class="row g-3">            
            @if (icaoService.IcaoList != null)
            {
                <div class="col-3">
                    <MudAutocomplete T="string"
                                     @bind-Value="ChartSvc.CurrentIcao"
                                     SearchFunc="@SearchIcao"
                                     OnBlur="OnAutoCompleteBlur"
                                     MinCharacters="1"
                                     MaxItems="7"
                                     OpenIcon="@Icons.Material.Filled.ArrowDropDown"
                                     Dense="true"
                                     Variant="Variant.Outlined"
                                     Clearable="false"
                                     Placeholder="ICAO"
                                     InputAttributes="@(new Dictionary<string, object> { { "aria-label", "ICAO" } })"
                                     @onkeydown="OnAutoCompleteKeyDown" />
                </div>
            
                <div class="col-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mud-button-filled" OnClick="Search">Search</MudButton>
                </div>
            }
            else
            {
                <div class="col-2">
                    <MudTextField T="string"
                                  @bind-Value="ChartSvc.CurrentIcao"
                                  Immediate="true"
                                  Placeholder="ICAO"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  @onkeydown="OnTextFieldKeyDown" />
                </div>
                
                <div class="col-2">
                    <MudButton Style="margin-top:27px" Variant="Variant.Filled" Color="Color.Primary" OnClick="Search">Search</MudButton>
                </div>
            }
          
            @if (charts != null && !showChartFox)
            {
                <div class="col-8">
                    @foreach (var group in charts.GroupBy(c => c.chart_type))
                    {
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="@group.Key" DisablePadding="true">
                                <MudPaper Class="pa-2">
                                    @foreach (var chart in group)
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Class="mud-mb-2"
                                                   OnClick="() => SelectedItem(chart)">
                                            @chart.chart_name
                                        </MudButton>
                                    }
                                </MudPaper>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </div>
            }
            else if (showChartFox)
            {
                <div class="row g-3">
                    <div class="row-5">
                        <MudButton Style="margin-top:27px" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenChartFox">
                            Not found, try in ChartFox (login credentials required)
                        </MudButton>
                    </div>
                </div>
            }
            
        </div> 
    </MudExpansionPanel>
</MudExpansionPanels>

<div class="row g-3">
    <div class="col-12">
        <section id="chart" />
        @if (BrowserSvc.CanDisplayPdf() && ChartSvc.ShowPdf)
        {
            <PdfReader @ref="PdfReader" FileName="@ChartSvc.Pdf" Pagemode="EnumPageMode.None" Navpanes="false" StreamMode="true" Height="1100px" />
        }
    </div>
</div>
<div class="row g-3">
    <div class="col-12">
        Use with caution. The owner of this webpage not responsible for any misuse of outdated charts or other information as it is intended for flight simulation use.
    </div>
</div>

@code {
    PdfReader PdfReader { get; set; }

    private HttpClient client = new HttpClient();
    private List<SingleChart> charts;
    private bool showChartFox = false;

    protected override async Task OnInitializedAsync()
    {
        var pdf = ChartSvc.ShowPdf;
        if (!String.IsNullOrEmpty(ChartSvc.CurrentIcao))
        {
            await Search();
            ChartSvc.ShowPdf = pdf;
        }
    }

    private async Task<IEnumerable<string>> SearchIcao(string value, CancellationToken token)
    {
        var list = icaoService.IcaoList ?? Enumerable.Empty<string>();

        // When input is empty show top items (or return empty to avoid dropdown)
        if (string.IsNullOrWhiteSpace(value))
            return list.Take(7);

        // Case-insensitive contains matching; adjust to StartsWith for prefix matching
        var results = list
            .Where(i => i.Contains(value, StringComparison.OrdinalIgnoreCase))
            .OrderBy(i => i)
            .Take(30);

        return await Task.FromResult(results);
    }
    // private FormItemValidator OnValidate()
    // {
    //     return null;
    // }

    private async Task OnEnterAsync(string icao)
    {
        if (icao.Equals(".") && !String.IsNullOrEmpty(WeatherSvc.ICAO))
        {
            icao = WeatherSvc.ICAO;
            ChartSvc.CurrentIcao = icao;
        }

        ChartSvc.CurrentIcao = icao.ToUpper();

        await PerformSearch(ChartSvc.CurrentIcao);
        await InvokeAsync(StateHasChanged);
    }

    private async Task Search()
    {
        ChartSvc.CurrentIcao = ChartSvc.CurrentIcao.ToUpper();
        await PerformSearch(ChartSvc.CurrentIcao);
    }

    private async Task PerformSearch(string icao)
    {
        ChartSvc.ShowPdf = false;
        if (string.IsNullOrEmpty(icao?.Trim()))
        {
            return;
        }

        showChartFox = true;
        try
        {
            var response = await client.GetStringAsync($"https://api-v2.aviationapi.com/v2/charts?airport={icao}");
            response = response
                .Replace($"\"{icao}\":", "\"ICAO\":")
                .Replace($"\"K{icao}\":", "\"ICAO\":")
                .Replace("\"APD\"", "\"Airport Diagram\"")
                .Replace("\"DP\"", "\"Departures (SID)\"")
                .Replace("\"HOT\"", "\"Hot Spots\"")
                .Replace("\"IAP\"", "\"Approaches\"")
                .Replace("\"MIN\"", "\"Minimums\"")
                .Replace("\"STAR\"", "\"Arrivals (STAR)\"")
                .Replace("\"DAU\"", "\"Departure AAUP\"")
                .Replace("\"LAH\"", "\"Land and Hold Short\"")
                ;
            var chartRoot = JsonConvert.DeserializeObject<ChartRoot>(response);
            var allCharts = chartRoot.charts;

            charts = new List<SingleChart>();
            foreach (var c in allCharts.airport_diagram)
            {
                showChartFox = false;
                charts.Add(c);
                c.chart_type = "Airport Diagram";
            }

            foreach (var c in allCharts.general)
            {
                showChartFox = false;
                charts.Add(c);
                c.chart_type = "General";
            }

            foreach (var c in allCharts.departure)
            {
                showChartFox = false;
                charts.Add(c);
                c.chart_type = "Departure";
            }

            foreach (var c in allCharts.arrival)
            {
                showChartFox = false;
                charts.Add(c);
                c.chart_type = "Arrival";
            }

            foreach (var c in allCharts.approach)
            {
                showChartFox = false;
                charts.Add(c);
                c.chart_type = "Approach";
            }

        }
        catch
        {
            charts = null;
            showChartFox = true;
        }
    }

    private async Task SelectedItem(SingleChart chart)
    {
        ChartSvc.Pdf = chart.pdf_url;

        if (BrowserSvc.CanDisplayPdf())
        {
            ChartSvc.ShowPdf = true;
            if (PdfReader != null)
            {
                //for some reason, it is one behind so need to refresh twice
                await PdfReader!.Refresh();
                await InvokeAsync(StateHasChanged);
                await PdfReader!.Refresh();
            }

            await InvokeAsync(StateHasChanged);
            await jsRuntime.InvokeVoidAsync("scrollIntoView", "chart");
        }
        else
        {
            await jsRuntime.InvokeVoidAsync("blazorOpen", chart.pdf_url, chart.chart_name.Replace(" ", String.Empty));
        }
    }

    public async Task OpenChartFox()
    {
        var url = $"https://chartfox.org/{ChartSvc.CurrentIcao}";
        await jsRuntime.InvokeVoidAsync("blazorOpen", url, "cf");
    }

    // keyboard handlers forwarded from Mud components
    private async Task OnAutoCompleteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnEnterAsync(ChartSvc.CurrentIcao);
        }
    }

    private async Task OnTextFieldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnEnterAsync(ChartSvc.CurrentIcao);
        }
    }

    // Optionally trigger search on blur (user selected via mouse then clicked away)
    private async Task OnAutoCompleteBlur(FocusEventArgs _)
    {
        if (!string.IsNullOrWhiteSpace(ChartSvc.CurrentIcao))
        {
            await Search();
        }
    }
}

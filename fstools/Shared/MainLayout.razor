@using MudBlazor
@using fstools.Models;
@using fstools.Services;

@inherits LayoutComponentBase
@inject TimerService Timers
@inject IJSRuntime jsRuntime;
@inject BrowserService browser;


<PageTitle>FS Tools</PageTitle>

@* Use provider components as self-closing (some MudBlazor versions expect this) *@
<MudThemeProvider Theme="_myTheme" /> 
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="app-layout">
    <div class="page">
        <div class="sidebar" style="@IconMenuCssClass">
            <NavMenu ShowIconMenu="ToggleIconMenu" />
        </div>

        <main>
            <div class="top-row px-4">
                <div class="col-11">
                    <StopwatchComponent timerText="Timer 1" timerNumber=1 timersIn="@Timers.Timers" infoIn="@Timers.Info" fontSize="20px" />
                </div>
            </div>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code
{
    private bool _iconMenuActive { get; set; }
    private string IconMenuCssClass => _iconMenuActive ? "width: 80px;" : null;

    private MudTheme _myTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Blue.Default,
            Secondary = Colors.Green.Accent4,
            Tertiary = Colors.Purple.Default,
            AppbarBackground = Colors.Gray.Darken3,
            AppbarText = Colors.Shades.White,
            Background = Colors.Gray.Lighten5,
            Surface = Colors.Shades.White,
            Success = Colors.Green.Default,
            Warning = Colors.Orange.Default,
            Error = Colors.Red.Default,
            Info = Colors.LightBlue.Default
        },
        //note: Dark Mode not currently used, colors would need to be set better
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Blue.Lighten1,
            Secondary = Colors.Green.Accent2,
            Tertiary = Colors.Purple.Lighten2,
            AppbarBackground = Colors.Gray.Darken4,
            AppbarText = Colors.Shades.White,
            Background = Colors.Gray.Darken3,
            Surface = Colors.Gray.Darken4,
            Success = Colors.Green.Accent3,
            Warning = Colors.Orange.Darken2,
            Error = Colors.Red.Darken2,
            Info = Colors.LightBlue.Lighten1
        }
    };
    //Callback method from NavMenu to toggle weather side menu 
    // has descriptions or just icons
    public virtual void ToggleIconMenu(bool iconMenuActive)
    {
        _iconMenuActive = iconMenuActive;
    }

    protected override async Task OnAfterRenderAsync(bool _)
    {
        await browser.GetData();
    }
}

@using MudBlazor
@using fstools.Models;
@using fstools.Services;


<MudExpansionPanels>
    <MudExpansionPanel Class="mud-expansion-panel-lightblue-header" Expanded="false" Text="@Title()">
        @if (WeatherInfo != null)
        {
            <MudGrid GutterSize="3">
                <MudItem xs="12">
                <MudText Typo="Typo.body1"><b>Pilot Reports for Area:</b></MudText>
                    <MudList T="string" Dense="true">
                    @foreach (var c in WeatherInfo.PirepData.Line_by_line)
                    {
                        <MudListItem>@c</MudListItem>
                    }
                </MudList>
            </MudItem>
        </MudGrid>
        }
        else
        {
            <label>PIREP data not found</label>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

       
@code {
    [Parameter]
    public String ICAO { get; set; }

    [Parameter]
    public PirepInfo WeatherInfo { get; set; }


    protected string Title()
    {
        return $"PIREP for {ICAO.ToUpper()}";
    }
}

@using MudBlazor
@using fstools.Models;
@using fstools.Services;


<MudExpansionPanels>
    <MudExpansionPanel Class="mud-expansion-panel-lightblue-header" Expanded="true" Text="@Title()">       
        @if (WeatherInfo != null)
        {
            <MudGrid GutterSize="3">
                <MudItem xs="12">
                    <MudText Typo="Typo.body1"><b>Issue Time:</b> @WeatherInfo.TafData.IssueTime</MudText>
                </MudItem>
@*                <div class="row g-3">
                <div class="col-12">
                    <b>Valid Time:</b> @WeatherInfo.TafData.ValidTimeTo
                </div>
            </div>*@

                <MudItem xs="12">
                    <MudText Typo="Typo.body1"><b>Issue Time:</b> @WeatherInfo.TafData.IssueTime</MudText>
                </MudItem>

                 <MudItem xs="12">
                    <MudText Typo="Typo.body1"><b>Raw TAF:</b></MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var c in WeatherInfo.TafData.Line_by_line)
                        {
                            <MudListItem>@c</MudListItem>
                        }
                    </MudList>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <label>TAF data not found</label>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

       
@code {
    [Parameter]
    public String ICAO { get; set; }

    [Parameter]
    public TafInfo WeatherInfo { get; set; }


    protected string Title()
    {
        return $"TAF for {ICAO.ToUpper()}";
    }
}
